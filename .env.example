# =========================
# Backend
# =========================
# Copy this file to `.env` at the repository root.
# The web and driver apps each have their own env example:
#   apps/web/.env.example
#   apps/driver-mobile/.env.example
APP_ENV=development
APP_PORT=8080
APP_BASE_URL=http://localhost:8080

# These hostnames are Docker Compose service names, resolved inside the
# compose network where the api/worker containers run.
# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@postgres:5432/staff_transport?sslmode=disable

# Redis (also used for refresh-token storage and Asynq)
REDIS_URL=redis://redis:6379/0

# Auth
JWT_ACCESS_SECRET=change-me-in-development
JWT_REFRESH_SECRET=change-me-in-development
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h

# Organization
ORG_TIMEZONE=Asia/Kathmandu

# Local seed account (development only; never reuse these defaults in production)
SEED_MANAGER_NAME=Demo Manager
SEED_MANAGER_EMAIL=manager@example.com
SEED_MANAGER_PASSWORD=changeme123

# Maps
GOOGLE_MAPS_API_KEY=

# Notifications
EXPO_ACCESS_TOKEN=
